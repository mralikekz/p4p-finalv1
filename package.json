{
  "name": "p4p-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "esbuild": "^0.20.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24"
  }
}
